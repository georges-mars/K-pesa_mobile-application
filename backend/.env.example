# Server
PORT=3000
BASE_URL=https://api.k-pesa.tech
NODE_ENV=production

# JWT
JWT_SECRET=change_me_to_at_least_32_random_hex_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kpesa
DB_USER=kpesa_user
DB_PASSWORD=change_me

# Safaricom Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_ENV=sandbox

# Africa's Talking
AT_USERNAME=cyberpark
AT_API_KEY=

# Email (nodemailer / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=otp@k-pesa.tech
ADMIN_EMAIL=admin@k-pesa.tech

# Deriv — App ID only. Deriv returns tokens directly in the OAuth redirect URL.
# No client_secret is required.
DERIV_APP_ID=00010190

# Encryption keys (64-char hex strings)
MASTER_KEY=change_me_to_64_char_hex_string_32_bytes_for_encryption
DB_ENCRYPTION_KEY=change_me_to_at_least_32_random_hex_chars

# Optional
ALLOWED_ORIGINS=https://k-pesa.tech
LOG_LEVEL=info
